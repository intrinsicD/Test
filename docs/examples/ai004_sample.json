        "triangles": 4,
        "triangle_quality": {
          "min": 0.8,
          "mean": 0.9,
          "max": 0.95
        }
      }
    }
  ],
  "rendering": {
    "schema": {
      "id": "ai-004.rendering",
      "version": 1
    },
    "preset": "research-baseline",
    "options": {
