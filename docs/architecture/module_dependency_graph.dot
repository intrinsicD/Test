digraph ModuleDependencies {
    graph [rankdir=LR, fontsize=12];
    node [shape=box, style="rounded,filled", fillcolor="#1f2933", fontcolor="#f9fafb", penwidth=1.2];
    edge [color="#4b5563", penwidth=1.2, arrowsize=0.85];
    "math" [label="Math"];
    "animation" [label="Animation"];
    "assets" [label="Assets"];
    "compute" [label="Compute"];
    "core" [label="Core"];
    "geometry" [label="Geometry"];
    "io" [label="IO"];
    "physics" [label="Physics"];
    "platform" [label="Platform"];
    "rendering" [label="Rendering"];
    "scene" [label="Scene"];
    "runtime" [label="Runtime"];
    "tools" [label="Tools"];
    "animation" -> "math";
    "assets" -> "geometry";
    "assets" -> "io";
    "assets" -> "platform";
    "compute" -> "math";
    "geometry" -> "animation";
    "geometry" -> "core";
    "geometry" -> "io";
    "geometry" -> "math";
    "io" -> "animation";
    "io" -> "core";
    "io" -> "geometry";
    "physics" -> "geometry";
    "physics" -> "math";
    "rendering" -> "assets";
    "rendering" -> "core";
    "rendering" -> "geometry";
    "rendering" -> "platform";
    "rendering" -> "scene";
    "scene" -> "core";
    "scene" -> "math";
    "runtime" -> "animation";
    "runtime" -> "assets";
    "runtime" -> "compute";
    "runtime" -> "core";
    "runtime" -> "geometry";
    "runtime" -> "io";
    "runtime" -> "math";
    "runtime" -> "physics";
    "runtime" -> "platform";
    "runtime" -> "rendering";
    "runtime" -> "scene";
    "tools" -> "core";
    "tools" -> "runtime";
}
